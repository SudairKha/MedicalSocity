                        </NavLink>
                    </li>

                    <!-- ✅ IMPORTANT: Match this with page route -->
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/past-presidents">
                            Past Presidents
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link" href="/annualgathering">
