@page "/past-presidents"
@using Entities
@using DAL
@inject PastPresidentDAL dal
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #0a0e27 0%, #0f1235 100%);
        min-height: 100vh;
    }

    /* Navbar */
    .main-navbar {
        background: rgba(8, 12, 26, 0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(124, 58, 237, 0.3);
        position: sticky;
        top: 0;
        z-index: 99;
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .navbar-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 20px;
        font-weight: 700;
        background: linear-gradient(135deg, #c084fc, #7c3aed);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

        .navbar-brand i {
            font-size: 24px;
            color: #7c3aed;
        }

    .mobile-menu-btn {
        background: none;
        border: none;
        color: #c084fc;
        font-size: 24px;
        cursor: pointer;
        display: none;
    }

    .nav-links {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .nav-link {
        text-decoration: none;
        color: #94a3b8;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s;
        padding: 8px 0;
    }

        .nav-link:hover {
            color: #c084fc;
        }

        .nav-link.active {
            color: #c084fc;
            font-weight: 600;
            border-bottom: 2px solid #7c3aed;
        }

    .admin-nav-btn {
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

        .admin-nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
        }

    /* Page Container */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 24px;
    }

    /* Header */
    .page-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .header-tag {
        font-size: 11px;
        letter-spacing: 4px;
        color: #c084fc;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 15px;
    }

    .page-title {
        font-size: 56px;
        font-weight: 700;
        color: #e2e8f0;
        margin-bottom: 20px;
    }

    .title-highlight {
        background: linear-gradient(135deg, #c084fc, #7c3aed);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .title-divider {
        width: 70px;
        height: 3px;
        background: linear-gradient(90deg, #7c3aed, #c084fc);
        margin: 0 auto 20px;
        border-radius: 3px;
    }

    .page-subtitle {
        font-size: 14px;
        color: #94a3b8;
    }

    /* Stats */
    .stats-row {
        display: flex;
        justify-content: center;
        gap: 25px;
        margin-bottom: 40px;
        flex-wrap: wrap;
    }

    .stat-box {
        background: rgba(15, 18, 53, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 20px 40px;
        text-align: center;
        border: 1px solid rgba(124, 58, 237, 0.2);
        min-width: 160px;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #c084fc, #7c3aed);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .stat-label {
        color: #94a3b8;
        font-size: 0.8rem;
        margin-top: 5px;
    }

    /* Search */
    .search-wrapper {
        max-width: 400px;
        margin: 0 auto 30px;
    }

    .search-input-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #7c3aed;
        font-size: 14px;
    }

    .search-input {
        width: 100%;
        padding: 12px 40px 12px 42px;
        border: 1px solid rgba(124, 58, 237, 0.3);
        border-radius: 40px;
        background: rgba(15, 18, 53, 0.8);
        color: #e2e8f0;
        font-size: 13px;
        font-family: 'Poppins', sans-serif;
    }

        .search-input:focus {
            outline: none;
            border-color: #7c3aed;
        }

    .search-clear-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
    }

        .search-clear-btn:hover {
            color: #c084fc;
        }

    .search-result-count {
        text-align: center;
        font-size: 12px;
        color: #94a3b8;
        margin-top: 10px;
    }

    /* Table */
    .table-wrapper {
        background: rgba(15, 18, 53, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        overflow-x: auto;
        border: 1px solid rgba(124, 58, 237, 0.2);
    }

    .elegant-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

        .elegant-table thead tr {
            background: linear-gradient(135deg, #7c3aed, #c084fc);
        }

        .elegant-table th {
            padding: 16px 20px;
            text-align: left;
            font-weight: 600;
            font-size: 13px;
            color: white;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .elegant-table td {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(124, 58, 237, 0.15);
            color: #e2e8f0;
            font-size: 14px;
        }

        .elegant-table tbody tr:hover {
            background: rgba(124, 58, 237, 0.1);
        }

    .serial-cell {
        font-weight: 600;
        color: #c084fc;
        width: 60px;
    }

    .name-cell {
        font-weight: 600;
    }

    .name-icon {
        color: #c084fc;
        margin-right: 10px;
    }

    .tenure-cell {
        font-size: 13px;
    }

    .tenure-badge {
        display: inline-block;
        background: rgba(124, 58, 237, 0.2);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        color: #c084fc;
        border: 1px solid rgba(124, 58, 237, 0.3);
    }

    .services-cell {
        color: #94a3b8;
        font-size: 13px;
        max-width: 400px;
        word-wrap: break-word;
    }

    .no-data {
        color: #64748b;
        font-style: italic;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-container {
        background: linear-gradient(135deg, #0f1235, #0a0e27);
        border-radius: 28px;
        width: 550px;
        max-width: 90%;
        max-height: 85vh;
        overflow-y: auto;
        border: 1px solid rgba(124, 58, 237, 0.4);
    }

    .modal-header {
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        padding: 18px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 28px 28px 0 0;
    }

        .modal-header h3 {
            color: white;
            margin: 0;
            font-size: 18px;
        }

    .modal-close {
        background: rgba(255, 255, 255, 0.15);
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        color: white;
        font-size: 20px;
        cursor: pointer;
    }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.3);
        }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid rgba(124, 58, 237, 0.3);
        display: flex;
        justify-content: flex-end;
    }

    .btn-secondary {
        background: none;
        border: 1px solid #7c3aed;
        padding: 8px 24px;
        border-radius: 30px;
        color: #c084fc;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #7c3aed, #c084fc);
            color: white;
        }

    /* Login Section */
    .login-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

        .login-icon i {
            font-size: 32px;
            color: white;
        }

    .input-field {
        position: relative;
        margin-bottom: 15px;
    }

        .input-field i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #7c3aed;
        }

        .input-field input {
            width: 100%;
            padding: 12px 12px 12px 42px;
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 14px;
            background: rgba(15, 18, 53, 0.8);
            color: #e2e8f0;
            font-family: 'Poppins', sans-serif;
        }

            .input-field input:focus {
                outline: none;
                border-color: #7c3aed;
            }

    .btn-primary {
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
        }

    /* Admin Section */
    .admin-header-info {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(124, 58, 237, 0.3);
        color: #c084fc;
    }

    .admin-badge {
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        margin-left: auto;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 14px;
            background: rgba(15, 18, 53, 0.8);
            color: #e2e8f0;
            font-family: 'Poppins', sans-serif;
        }

        .form-group textarea {
            resize: vertical;
        }

    .form-row {
        display: flex;
        gap: 15px;
    }

        .form-row .form-group {
            flex: 1;
        }

    .action-buttons {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-save {
        flex: 2;
        padding: 12px;
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-cancel {
        flex: 1;
        padding: 12px;
        background: #334155;
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-logout {
        width: 100%;
        padding: 12px;
        background: #ef4444;
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 15px;
    }

        .btn-save:hover, .btn-cancel:hover, .btn-logout:hover {
            transform: translateY(-2px);
        }

    .error-msg {
        background: rgba(239, 68, 68, 0.2);
        color: #f87171;
        padding: 10px;
        border-radius: 12px;
        font-size: 13px;
        margin-bottom: 15px;
        border: 1px solid #ef4444;
    }

    .success-msg {
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        padding: 10px;
        border-radius: 12px;
        font-size: 13px;
        margin-bottom: 15px;
        border: 1px solid #10b981;
    }

    /* Quick View Modal */
    .quickview-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .quickview-container {
        background: linear-gradient(135deg, #0f1235, #0a0e27);
        border-radius: 28px;
        width: 500px;
        max-width: 90%;
        border: 1px solid rgba(124, 58, 237, 0.4);
    }

    .quickview-header {
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        padding: 18px 24px;
        border-radius: 28px 28px 0 0;
    }

        .quickview-header h3 {
            color: white;
            margin: 0;
        }

    .quickview-body {
        padding: 24px;
    }

    .detail-row {
        margin-bottom: 15px;
    }

        .detail-row label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #c084fc;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .detail-row p {
            color: #e2e8f0;
            font-size: 14px;
            line-height: 1.5;
        }

    .quickview-footer {
        padding: 16px 24px;
        border-top: 1px solid rgba(124, 58, 237, 0.3);
        display: flex;
        justify-content: flex-end;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-title {
            font-size: 40px;
        }

        .stats-row {
            gap: 15px;
        }

        .stat-box {
            padding: 15px 25px;
        }

        .stat-number {
            font-size: 1.5rem;
        }

        .mobile-menu-btn {
            display: block;
        }

        .nav-links {
            display: none;
        }

        .page-container {
            padding: 20px 16px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .form-row {
            flex-direction: column;
            gap: 0;
        }
    }
</style>

<!-- Navbar -->
<div class="main-navbar">
    <div class="navbar-brand">
        <i class="bi bi-hospital-fill"></i>
        <span>Medical Society</span>
    </div>
    <button class="mobile-menu-btn" @onclick="ToggleMobileMenu">
        <i class="fas fa-bars"></i>
    </button>
    <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/leadership" class="nav-link">Leadership</a>
        <a href="/cabinet" class="nav-link">Cabinet</a>
        <a href="/annualprogram" class="nav-link">Annual Programs</a>
        <a href="/annualgathering" class="nav-link">Annual Gathering</a>
        <a href="/past-presidents" class="nav-link active">Past Presidents</a>
        <a href="/objectives" class="nav-link">Objectives</a>
    </div>
    <button class="admin-nav-btn" @onclick="OpenModal">
        <i class="bi bi-shield-lock-fill"></i> Admin
    </button>
</div>

<!-- Main Content -->
<div class="page-container">
    <div class="page-header">
        <span class="header-tag">✦ L E A D E R S H I P  L E G A C Y ✦</span>
        <h1 class="page-title">past <span class="title-highlight">presidents</span></h1>
        <div class="title-divider"></div>
        <p class="page-subtitle">honoring those who shaped our society</p>
    </div>

    <div class="stats-row">
        <div class="stat-box">
            <div class="stat-number">@(presidents?.Count ?? 0)</div>
            <div class="stat-label">Total Presidents</div>
        </div>
        <div class="stat-box">
            <div class="stat-number">@(presidents?.Count(x => x.EndDate != null) ?? 0)</div>
            <div class="stat-label">Completed Tenures</div>
        </div>
        <div class="stat-box">
            <div class="stat-number">Years</div>
            <div class="stat-label">Of Leadership</div>
        </div>
    </div>

    <div class="search-wrapper">
        <div class="search-input-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" @bind="searchTerm" @bind:event="oninput" placeholder="Search by president name..." />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="search-clear-btn" @onclick="() => searchTerm = string.Empty">
                    <i class="fas fa-times"></i>
                </button>
            }
        </div>
        <div class="search-result-count">@FilteredPresidents.Count() presidents found</div>
    </div>

    <div class="table-wrapper">
        @if (isLoading)
        {
            <div class="loading-state">
                <i class="fas fa-spinner fa-spin"></i>
                <p>loading past presidents...</p>
            </div>
        }
        else if (presidents == null || !presidents.Any())
        {
            <div class="empty-state">
                <i class="fas fa-crown"></i>
                <p>No past presidents recorded</p>
                <button class="empty-add-btn" @onclick="OpenModal">Add First President</button>
            </div>
        }
        else if (!FilteredPresidents.Any())
        {
            <div class="empty-state">
                <i class="fas fa-search"></i>
                <p>No matching presidents found</p>
                <button class="empty-add-btn" @onclick="() => searchTerm = string.Empty">Clear Search</button>
            </div>
        }
        else
        {
            <table class="elegant-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>President Name</th>
                        <th>Tenure</th>
                        <th>Key Services / Achievements</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 1;
                    }
                    @foreach (var president in FilteredPresidents.OrderByDescending(x => x.JoinDate))
                    {
                        <tr>
                            <td class="serial-cell">@counter</td>
                            <td class="name-cell">
                                <i class="fas fa-crown name-icon"></i>
                                @president.PresidentName
                            </td>
                            <td class="tenure-cell">
                                @if (president.JoinDate.HasValue && president.EndDate.HasValue)
                                {
                                    <span class="tenure-badge">@president.JoinDate.Value.ToString("yyyy") - @president.EndDate.Value.ToString("yyyy")</span>
                                }
                                else if (president.JoinDate.HasValue)
                                {
                                    <span class="tenure-badge">@president.JoinDate.Value.ToString("yyyy") onward</span>
                                }
                                else
                                {
                                    <span class="tenure-badge">—</span>
                                }
                            </td>
                            <td class="services-cell">
                                @if (!string.IsNullOrEmpty(president.Services))
                                {
                                    @president.Services
                                }
                                else
                                {
                                    <span class="no-data">—</span>
                                }
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Admin Modal (All actions inside) -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModalOnOverlay">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="fas fa-shield-alt me-2"></i>@(isAdmin ? "Admin Panel" : "Admin Access")</h3>
                <button class="modal-close" @onclick="CloseModal">×</button>
            </div>
            <div class="modal-body">
                @if (!isAdmin)
                {
                    <div class="login-section">
                        <div class="login-icon">
                            <i class="fas fa-lock"></i>
                        </div>
                        <h4 style="text-align:center;color:#e2e8f0;margin-bottom:5px;">Authentication Required</h4>
                        <p style="text-align:center;color:#94a3b8;margin-bottom:20px;">Enter admin credentials to manage past presidents</p>
                        <div class="input-field">
                            <i class="fas fa-user"></i>
                            <input type="text" @bind="username" placeholder="Username" />
                        </div>
                        <div class="input-field">
                            <i class="fas fa-lock"></i>
                            <input type="password" @bind="password" placeholder="Password" />
                        </div>
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="error-msg">@error</div>
                        }
                        <button class="btn-primary" @onclick="Login">Login</button>
                    </div>
                }
                else
                {
                    <div>
                        <div class="admin-header-info">
                            <i class="fas fa-database"></i>
                            <span>Manage Past Presidents</span>
                            <span class="admin-badge">Active</span>
                        </div>

                        @if (!string.IsNullOrEmpty(editError))
                        {
                            <div class="error-msg">@editError</div>
                        }
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="success-msg">@successMessage</div>
                        }

                        <!-- Edit Form with all fields -->
                        <div class="form-group">
                            <label>President Name *</label>
                            <input type="text" @bind="editPresident.PresidentName" placeholder="e.g., Dr. John Smith" />
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Join Date</label>
                                <input type="date" @bind="editPresident.JoinDate" />
                            </div>
                            <div class="form-group">
                                <label>End Date</label>
                                <input type="date" @bind="editPresident.EndDate" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Services / Achievements</label>
                            <textarea @bind="editPresident.Services" rows="4" placeholder="Key contributions and achievements during tenure..."></textarea>
                        </div>

                        <div class="action-buttons">
                            <button class="btn-save" @onclick="Save" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <i class="fas fa-spinner fa-spin"></i>
                                }
                                else
                                {
                                    <i class="fas fa-save"></i>
                                }
                                @(string.IsNullOrEmpty(editPresident.Id) ? "Add President" : "Update President")
                            </button>
                            @if (!string.IsNullOrEmpty(editPresident.Id))
                            {
                                <button class="btn-cancel" @onclick="CancelEdit">Cancel</button>
                            }
                        </div>

                        <hr style="border-color: rgba(124,58,237,0.3); margin: 20px 0;" />

                        <!-- Manage List -->
                        <div class="admin-header-info" style="margin-bottom: 15px;">
                            <i class="fas fa-list"></i>
                            <span>Existing Presidents</span>
                            <span class="admin-badge">@(presidents?.Count ?? 0) records</span>
                        </div>

                        <div style="max-height: 300px; overflow-y: auto;">
                            @if (presidents == null || !presidents.Any())
                            {
                                <div style="text-align:center; padding: 20px; color: #94a3b8;">No presidents yet</div>
                            }
                            else
                            {
                                @foreach (var president in presidents.OrderByDescending(x => x.JoinDate))
                                {
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: rgba(15,18,53,0.6); border-radius: 14px; margin-bottom: 10px; border: 1px solid rgba(124,58,237,0.2);">
                                        <div>
                                            <strong style="color: #e2e8f0;">@president.PresidentName</strong>
                                            @if (president.JoinDate.HasValue && president.EndDate.HasValue)
                                            {
                                                <div style="font-size: 11px; color: #94a3b8;">@president.JoinDate.Value.ToString("yyyy") - @president.EndDate.Value.ToString("yyyy")</div>
                                            }
                                            else if (president.JoinDate.HasValue)
                                            {
                                                <div style="font-size: 11px; color: #94a3b8;">Since @president.JoinDate.Value.ToString("yyyy")</div>
                                            }
                                        </div>
                                        <div style="display: flex; gap: 8px;">
                                            <button class="action-icon edit-icon" @onclick="() => LoadEdit(president)" style="background: rgba(124,58,237,0.2); color: #c084fc; border: none; width: 32px; height: 32px; border-radius: 8px; cursor: pointer;">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                            <button class="action-icon delete-icon" @onclick="() => Delete(president)" style="background: rgba(239,68,68,0.2); color: #f87171; border: none; width: 32px; height: 32px; border-radius: 8px; cursor: pointer;">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <button class="btn-logout" @onclick="Logout">Logout</button>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseModal">Close</button>
            </div>
        </div>
    </div>
}

<!-- Quick View Modal -->
@if (showQuickView && selectedPresident != null)
{
    <div class="quickview-overlay" @onclick="CloseQuickView">
        <div class="quickview-container" @onclick:stopPropagation="true">
            <div class="quickview-header">
                <h3><i class="fas fa-crown me-2"></i>President Details</h3>
            </div>
            <div class="quickview-body">
                <div class="detail-row">
                    <label>President Name</label>
                    <p><strong>@selectedPresident.PresidentName</strong></p>
                </div>
                <div class="detail-row">
                    <label>Tenure</label>
                    <p>
                        @if (selectedPresident.JoinDate.HasValue && selectedPresident.EndDate.HasValue)
                        {
                            <text>@selectedPresident.JoinDate.Value.ToString("yyyy") - @selectedPresident.EndDate.Value.ToString("yyyy")</text>
                        }
                        else if (selectedPresident.JoinDate.HasValue)
                        {
                            <text>Since @selectedPresident.JoinDate.Value.ToString("yyyy")</text>
                        }
                        else
                        {
                            <text>Not specified</text>
                        }
                    </p>
                </div>
                @if (!string.IsNullOrEmpty(selectedPresident.Services))
                {
                    <div class="detail-row">
                        <label><i class="fas fa-trophy me-1"></i> Key Services & Achievements</label>
                        <p>@selectedPresident.Services</p>
                    </div>
                }
            </div>
            <div class="quickview-footer">
                <button class="btn-secondary" @onclick="CloseQuickView">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<PastPresident> presidents = new();
    private PastPresident editPresident = new();
    private PastPresident? selectedPresident;

    private bool showModal = false;
    private bool isAdmin = false;
    private bool showQuickView = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool mobileMenuOpen = false;

    private string username = "";
    private string password = "";
    private string error = "";
    private string editError = "";
    private string successMessage = "";
    private string searchTerm = "";

    private IEnumerable<PastPresident> FilteredPresidents =>
        presidents.Where(x =>
            string.IsNullOrEmpty(searchTerm) ||
            x.PresidentName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadData();
        isLoading = false;
    }

    private async Task LoadData()
    {
        await Task.Run(() => { presidents = dal.GetAll(); });
        StateHasChanged();
    }

    private void OpenModal() => showModal = true;
    private void CloseModal() => showModal = false;
    private void CloseModalOnOverlay()
    {
        if (!isAdmin)
        {
            showModal = false;
        }
    }

    private void Login()
    {
        if (username == "admin" && password == "admin123")
        {
            isAdmin = true;
            error = "";
        }
        else
        {
            error = "Invalid credentials. Use admin/admin123";
        }
    }

    private void Logout()
    {
        isAdmin = false;
        editPresident = new();
        editError = "";
        successMessage = "";
        CloseModal();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editPresident.PresidentName))
        {
            editError = "President name is required";
            successMessage = "";
            return;
        }

        isSaving = true;
        editError = "";
        successMessage = "";

        try
        {
            await Task.Run(() =>
            {
                if (string.IsNullOrEmpty(editPresident.Id))
                {
                    editPresident.Id = null;
                    dal.Add(editPresident);
                    successMessage = "President added successfully!";
                }
                else
                {
                    dal.Update(editPresident);
                    successMessage = "President updated successfully!";
                }
            });
            await LoadData();
            editPresident = new();
            editError = "";

            await Task.Delay(3000);
            successMessage = "";
            StateHasChanged();
        }
        catch (Exception ex) { editError = $"Save failed: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private void LoadEdit(PastPresident p)
    {
        editPresident = new PastPresident
        {
            Id = p.Id,
            PresidentName = p.PresidentName,
            JoinDate = p.JoinDate,
            EndDate = p.EndDate,
            Services = p.Services
        };
        editError = "";
        successMessage = "";
    }

    private void CancelEdit()
    {
        editPresident = new();
        editError = "";
        successMessage = "";
    }

    private async Task Delete(PastPresident p)
    {
        if (!isAdmin) return;
        var confirmed = await jsRuntime.InvokeAsync<bool>("confirm", $"Delete past president '{p.PresidentName}'?");
        if (confirmed)
        {
            await Task.Run(() => dal.Delete(p.Id));
            await LoadData();
            if (editPresident.Id == p.Id) CancelEdit();
            successMessage = "President deleted successfully!";
            await Task.Delay(3000);
            successMessage = "";
            StateHasChanged();
        }
    }

    private void QuickView(PastPresident p)
    {
        selectedPresident = p;
        showQuickView = true;
    }

    private void CloseQuickView()
    {
        showQuickView = false;
        selectedPresident = null;
    }
}