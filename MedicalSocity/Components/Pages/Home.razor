    }

    .login-box {
        text-align: center;
    }

    .login-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }

        .login-icon i {
            font-size: 40px;
            color: white;
        }

    .login-box h4 {
        color: #c084fc;
        margin-bottom: 0.3rem;
    }

    .login-box p {
        color: #94a3b8;
        font-size: 0.85rem;
        margin-bottom: 1.6rem;
    }

    .input-group {
        display: flex;
        align-items: center;
        background: rgba(15, 18, 53, 0.8);
        border: 1px solid rgba(124, 58, 237, 0.3);
        border-radius: 16px;
        margin-bottom: 1rem;
    }

        .input-group:focus-within {
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2);
        }

        .input-group i {
            padding: 0 14px;
            color: #c084fc;
            font-size: 18px;
        }

    .form-input {
        flex: 1;
        padding: 12px 12px 12px 0;
        border: none;
        border-radius: 16px;
        font-size: 14px;
        font-family: 'Inter', sans-serif;
        background: transparent;
        color: #e2e8f0;
    }

        .form-input:focus {
            outline: none;
        }

    textarea.form-input {
        padding: 12px;
        border: 1px solid rgba(124, 58, 237, 0.3);
        border-radius: 16px;
        resize: vertical;
        background: rgba(15, 18, 53, 0.8);
    }

    .btn-login, .btn-update, .btn-refresh {
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        border: none;
        border-radius: 16px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-login:hover, .btn-update:hover, .btn-refresh:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(124, 58, 237, 0.4);
        }

    .admin-status {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(124, 58, 237, 0.3);
    }

        .admin-status i {
            font-size: 24px;
            color: #c084fc;
        }

        .admin-status span {
            font-weight: 600;
            color: #e2e8f0;
        }

    .admin-badge {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 11px;
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 6px;
        }

            .form-group label i {
                margin-right: 5px;
                color: #c084fc;
            }

    .info-card-mini {
        background: rgba(124, 58, 237, 0.1);
        padding: 12px;
        border-radius: 16px;
        margin: 1rem 0;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: #c084fc;
        border: 1px solid rgba(124, 58, 237, 0.2);
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 1.2rem;
        flex-wrap: wrap;
    }

    .error-text {
        color: #f87171;
        font-size: 13px;
        margin-top: 0.8rem;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
    }

    .success-text {
        color: #34d399;
        font-size: 13px;
        margin-top: 1rem;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
    }

    @@media (max-width: 1000px) {
        .mobile-menu-btn

    {
        display: block;
    }

    .navbar-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background: rgba(8, 12, 26, 0.98);
        flex-direction: column;
        padding: 20px;
        gap: 15px;
        border-bottom: 1px solid #7c3aed;
        z-index: 100;
    }

        .navbar-links.show {
            display: flex;
        }

    .nav-link {
        padding: 10px 0;
        text-align: center;
    }

    .admin-btn {
        margin-left: auto;
    }

    }

    @@media (max-width: 768px) {
        .home-page

    {
        padding: 0 1rem 2rem;
    }

    .hero-section h1 {
        font-size: 2rem;
    }

    .two-col {
        grid-template-columns: 1fr;
    }

    .navbar-container {
        padding: 12px 16px;
    }

    .modal-container {
        width: 95%;
    }

    }
</style>

<div class="main-navbar">
    <div class="navbar-container">
        <div class="navbar-brand">
            <i class="bi bi-hospital-fill"></i>
            <span>Medical Society</span>
        </div>
        <button class="mobile-menu-btn" @onclick="ToggleMobileMenu">
            <i class="fas fa-bars"></i>
        </button>
        <div class="navbar-links @(mobileMenuOpen ? "show" : "")">
            <a href="/" class="nav-link active">Home</a>
            <a href="/leadership" class="nav-link">Leadership</a>
            <a href="/cabinet" class="nav-link">Cabinet</a>
            <a href="/annualprogram" class="nav-link">Annual Programs</a>
            <a href="/annualgathering" class="nav-link">Annual Gathering</a>
            <a href="/past-presidents" class="nav-link">Past Presidents</a>
            <a href="/objectives" class="nav-link">Objectives</a>
        </div>
        <button class="admin-btn" @onclick="ToggleModal">
            <i class="bi bi-shield-lock-fill"></i> Admin
        </button>
    </div>
</div>

<div class="home-page">
    <div class="hero-section">
        <div class="hero-icon"><i class="bi bi-hospital-fill"></i></div>
        <h1>@(societyData?.SocietyName ?? "Medical Society of Excellence")</h1>
        <p>Premium Healthcare Community · Excellence in Medicine</p>
        <div class="hero-badges">
            <span class="badge">🏥 Community First</span>
            <span class="badge">⭐ Excellence Driven</span>
            <span class="badge">🌍 Global Impact</span>
        </div>
    </div>

    <div class="welcome-card">
        <h3><i class="bi bi-megaphone-fill"></i> Welcome Message</h3>
        <p>@(societyData?.Message ?? "Advancing medical frontiers with compassion and innovation.")</p>
        <div class="signature">— The Medical Society Team</div>
    </div>

    <div class="two-col">
        <div class="info-card">
            <div class="card-icon"><i class="bi bi-graph-up"></i></div>
            <h4>Our Aims</h4>
            <p>@(societyData?.Aims ?? "Foster research, elevate clinical standards, support education, and build global medical alliances.")</p>
            <div class="tags">#innovation #growth #excellence</div>
        </div>
        <div class="info-card">
            <div class="card-icon"><i class="bi bi-eye"></i></div>
            <h4>Our Vision</h4>
            <p>@(societyData?.Vision ?? "A world where equitable, cutting-edge healthcare is accessible to every community.")</p>
            <div class="tags">#future #impact #healthcare</div>
        </div>
    </div>
    <div class="footer">· join the movement · advance healthcare · save lives ·</div>
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModalOnOverlay">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-header-content">
                    <div class="modal-header-icon"><i class="bi bi-shield-lock-fill"></i></div>
                    <div class="modal-header-text">
                        <h3>Admin Control Panel</h3>
                        <p>Manage your homepage content</p>
                    </div>
                </div>
                <button class="modal-close" @onclick="ToggleModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                @if (!isAdminAuthenticated)
                {
                    <div class="login-box">
                        <div class="login-icon"><i class="bi bi-shield-lock-fill"></i></div>
                        <h4>Authentication Required</h4>
                        <p>Enter admin credentials to edit homepage content</p>
                        <div class="input-group"><i class="bi bi-person"></i><input class="form-input" placeholder="Username" @bind="adminUsername" /></div>
                        <div class="input-group"><i class="bi bi-key"></i><input class="form-input" type="password" placeholder="Password" @bind="adminPassword" /></div>
                        <button class="btn-login" @onclick="Login"><i class="bi bi-box-arrow-in-right"></i> Login to Continue</button>
                        @if (!string.IsNullOrEmpty(loginError))
                        {
                            <p class="error-text"><i class="bi bi-exclamation-triangle-fill"></i> @loginError</p>
                        }
                    </div>
                }
                else
                {
                    <div class="edit-form">
                        <div class="admin-status"><i class="bi bi-database"></i><span>Edit Homepage Content</span><span class="admin-badge"><i class="bi bi-shield-lock-fill"></i> Admin Mode Active</span></div>
                        <div class="form-group"><label><i class="bi bi-building"></i> Society Name</label><input class="form-input" @bind="editData.SocietyName" /></div>
                        <div class="form-group"><label><i class="bi bi-chat-dots"></i> Welcome Message</label><textarea class="form-input" rows="3" @bind="editData.Message"></textarea></div>
                        <div class="form-group"><label><i class="bi bi-bullseye"></i> Aims & Objectives</label><textarea class="form-input" rows="3" @bind="editData.Aims"></textarea></div>
                        <div class="form-group"><label><i class="bi bi-eye"></i> Vision Statement</label><textarea class="form-input" rows="3" @bind="editData.Vision"></textarea></div>
                        <div class="action-buttons"><button class="btn-update" @onclick="UpdateData"><i class="bi bi-pencil-square"></i> Update</button><button class="btn-refresh" @onclick="RefreshData"><i class="bi bi-arrow-repeat"></i> Refresh</button></div>
                        @if (!string.IsNullOrEmpty(message))
                        {
                            <p class="success-text"><i class="bi bi-check-circle-fill"></i> @message</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private SocietyInfoDAL dal = new SocietyInfoDAL();
    private SocietyInfo? societyData;
    private SocietyInfo editData = new SocietyInfo();
    private bool showModal = false;
    private bool isAdminAuthenticated = false;
    private bool mobileMenuOpen = false;
    private string adminUsername = "";
    private string adminPassword = "";
    private string loginError = "";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var data = await Task.Run(() => dal.GetAll());
        if (data != null && data.Count > 0)
        {
            societyData = data.First();
            editData = new SocietyInfo
            {
                Id = societyData.Id,
                SocietyName = societyData.SocietyName,
                Message = societyData.Message,
                Aims = societyData.Aims,
                Vision = societyData.Vision
            };
        }
        else
        {
            societyData = new SocietyInfo
            {
                Id = "1",
                SocietyName = "Medical Society of Excellence",
                Message = "Advancing medical frontiers with compassion and innovation. Join us to shape the future of healthcare.",
                Aims = "Foster research, elevate clinical standards, support education, and build global medical alliances.",
                Vision = "A world where equitable, cutting-edge healthcare is accessible to every community."
            };
        }
        StateHasChanged();
    }

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void ToggleModal() => showModal = !showModal;
    private void CloseModalOnOverlay() { showModal = false; isAdminAuthenticated = false; message = ""; }

    private async Task Login()
    {
        if (adminUsername == "admin" && adminPassword == "admin123")
        {
            isAdminAuthenticated = true;
            loginError = "";
        }
        else
        {
            loginError = "Invalid credentials! Use admin / admin123";
        }
        await Task.CompletedTask;
    }

    private async Task UpdateData()
    {
        if (societyData != null)
        {
            societyData.SocietyName = editData.SocietyName;
            societyData.Message = editData.Message;
            societyData.Aims = editData.Aims;
            societyData.Vision = editData.Vision;
            await Task.Run(() => dal.Update(societyData));
            message = "Record updated successfully!";
            StateHasChanged();
            await Task.Delay(3000);
            message = "";
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        message = "Data refreshed!";
        StateHasChanged();
        await Task.Delay(3000);
        message = "";
        StateHasChanged();
    }
}