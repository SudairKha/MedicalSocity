    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        z-index: 1001;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-container {
        background: linear-gradient(135deg, #0f1235, #0a0e27);
        border-radius: 32px;
        width: 90%;
        max-width: 600px;
        max-height: 85vh;
        overflow-y: auto;
        border: 1px solid rgba(124, 58, 237, 0.4);
