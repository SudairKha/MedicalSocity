    .modal-header {
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        padding: 1.2rem 1.8rem;
        border-radius: 32px 32px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .modal-header-icon {
        width: 45px;
        height: 45px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .modal-header-icon i {
            font-size: 24px;
            color: white;
        }

    .modal-header-text h3 {
        color: white;
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .modal-header-text p {
        color: rgba(255, 255, 255, 0.8);
