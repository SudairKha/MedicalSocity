@code {
    private LeadershipDAL dal = new LeadershipDAL();
    private List<Leadership> leadershipMembers = new();
    private Leadership editMember = new Leadership();
    private Leadership? selectedMember = null;
    private bool showModal = false;
    private bool isAdmin = false;
    private bool showQuickView = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool mobileMenuOpen = false;
    private string username = "";
    private string password = "";
    private string error = "";
    private string editError = "";
    private string uploadPath => Path.Combine(env.WebRootPath, "uploads");

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            Directory.CreateDirectory(uploadPath);
            await LoadData();
        }
        catch (Exception ex)
        {
            error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            leadershipMembers = dal.GetAll();
        });
        StateHasChanged();
    }

    private void OpenModal() => showModal = true;

    private void CloseModal()
    {
        showModal = false;
        editMember = new Leadership();
        username = "";
        password = "";
        error = "";
        editError = "";
        isSaving = false;
    }

    private async Task EnterLogin(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Login();
        }
    }

    private async Task Login()
    {
        await Task.Delay(1);
        if (username == "admin" && password == "admin123")
        {
            isAdmin = true;
            error = "";
        }
        else
        {
            error = "Invalid credentials. Use admin/admin123";
        }
        StateHasChanged();
    }

    private void Logout()
    {
        isAdmin = false;
        editMember = new Leadership();
        editError = "";
        CloseModal();
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            var fileName = Guid.NewGuid() + Path.GetExtension(file.Name);
            var fullPath = Path.Combine(uploadPath, fileName);

            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var fs = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fs);

            editMember.ProfilePicture = "/uploads/" + fileName;
            editError = "";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            editError = $"Upload failed: {ex.Message}";
        }
    }

    private void DeleteImage()
    {
        editMember.ProfilePicture = "";
    }

    private async Task Save()
    {
        if (!isAdmin) return;

        if (string.IsNullOrWhiteSpace(editMember.Name))
        {
            editError = "Name is required";
            return;
        }

        if (string.IsNullOrWhiteSpace(editMember.Status))
        {
            editError = "Status/Position is required";
            return;
        }

        isSaving = true;
        editError = "";

        try
        {
            await Task.Run(() =>
            {
                if (string.IsNullOrEmpty(editMember.Id))
                {
                    // ✅ Let MongoDB handle Id
                    dal.Add(editMember);
                }
                else
                {
                    dal.Update(editMember);
                }
            });

            await LoadData();
            CloseModal(); // leadership UI uses modal reset
        }
        catch (Exception ex)
        {
            editError = $"Save failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void LoadEdit(Leadership member)
    {
        editMember = new Leadership
        {
            Id = member.Id,
            Name = member.Name,
            Status = member.Status,
            ProfilePicture = member.ProfilePicture,
            Experiences = member.Experiences,
            Message = member.Message
        };
        editError = "";
    }

    private void CancelEdit()
    {
        editMember = new Leadership();
        editError = "";
    }

    private async Task Delete(Leadership member)
    {
        if (!isAdmin) return;

        var confirmed = await jsRuntime.InvokeAsync<bool>("confirm", $"Delete {member.Name}?");

        if (confirmed)
        {
            await Task.Run(() => dal.Delete(member.Id));
            await LoadData();
            if (editMember.Id == member.Id)
            {
                CancelEdit();
            }
        }
    }

    private void QuickView(Leadership member)
    {
        selectedMember = member;
        showQuickView = true;
    }

    private void CloseQuickView()
    {
        showQuickView = false;
        selectedMember = null;
    }
}