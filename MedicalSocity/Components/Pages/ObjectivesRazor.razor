@code {
    private SocietyObjectivesDAL dal = new SocietyObjectivesDAL();
    private List<SocietyObjectives> objectives = new();
    private SocietyObjectives editObjective = new SocietyObjectives();
    private SocietyObjectives? selectedObjective = null;
    private bool showModal = false;
    private bool isAdmin = false;
    private bool showQuickView = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool mobileMenuOpen = false;
    private string username = "";
    private string password = "";
    private string error = "";
    private string editError = "";
    private string successMessage = "";
    private string searchTerm = "";

    private IEnumerable<SocietyObjectives> FilteredObjectives => objectives?.Where(x =>
        string.IsNullOrEmpty(searchTerm) ||
        x.ObjectiveName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        (x.Description != null && x.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) ?? new List<SocietyObjectives>();

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            await LoadData();
        }
        catch (Exception ex)
        {
            error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        await Task.Run(() => { objectives = dal.GetAll(); });
        StateHasChanged();
    }

    private void OpenModal() => showModal = true;
    private void CloseModal() => showModal = false;
    private void CloseModalOnOverlay()
    {
        if (!isAdmin)
        {
            showModal = false;
        }
    }

    private async Task Login()
    {
        await Task.Delay(1);
        if (username == "admin" && password == "admin123")
        {
            isAdmin = true;
            error = "";
        }
        else
        {
            error = "Invalid credentials. Use admin/admin123";
        }
        StateHasChanged();
    }

    private void Logout()
    {
        isAdmin = false;
        editObjective = new SocietyObjectives();
        editError = "";
        successMessage = "";
        CloseModal();
    }

    private async Task Save()
    {
        if (!isAdmin) return;

        if (string.IsNullOrWhiteSpace(editObjective.ObjectiveName))
        {
            editError = "Objective name is required";
            successMessage = "";
            return;
        }

        isSaving = true;
        editError = "";
        successMessage = "";

        try
        {
            await Task.Run(() =>
            {
                if (string.IsNullOrEmpty(editObjective.Id))
                {
                    editObjective.Id = null;
                    dal.Add(editObjective);
                    successMessage = "Objective added successfully!";
                }
                else
                {
                    dal.Update(editObjective);
                    successMessage = "Objective updated successfully!";
                }
            });
            await LoadData();
            editObjective = new SocietyObjectives();
            editError = "";

            await Task.Delay(3000);
            successMessage = "";
            StateHasChanged();
        }
        catch (Exception ex) { editError = $"Save failed: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private void LoadEdit(SocietyObjectives objective)
    {
        editObjective = new SocietyObjectives
        {
            Id = objective.Id,
            ObjectiveName = objective.ObjectiveName,
            Description = objective.Description
        };
        editError = "";
        successMessage = "";
    }

    private void CancelEdit() { editObjective = new SocietyObjectives(); editError = ""; successMessage = ""; }

    private async Task Delete(SocietyObjectives objective)
    {
        if (!isAdmin) return;
        var confirmed = await jsRuntime.InvokeAsync<bool>("confirm", $"Delete objective '{objective.ObjectiveName}'?");
        if (confirmed)
        {
            await Task.Run(() => dal.Delete(objective.Id));
            await LoadData();
            if (editObjective.Id == objective.Id) CancelEdit();
            successMessage = "Objective deleted successfully!";
            await Task.Delay(3000);
            successMessage = "";
            StateHasChanged();
        }
    }

    private void QuickView(SocietyObjectives objective) { selectedObjective = objective; showQuickView = true; }
    private void CloseQuickView() { showQuickView = false; selectedObjective = null; }
}