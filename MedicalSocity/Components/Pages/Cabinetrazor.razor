@page "/cabinet"
@using Entities
@using DAL
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment env
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div class="main-navbar">
    <div class="navbar-container">
        <div class="navbar-brand">
            <i class="bi bi-hospital-fill"></i>
            <span>Medical Society</span>
        </div>
        <button class="mobile-menu-btn" @onclick="ToggleMobileMenu">
            <i class="fas fa-bars"></i>
        </button>
        <div class="navbar-links @(mobileMenuOpen ? "show" : "")">
            <a href="/" class="nav-link">Home</a>
            <a href="/leadership" class="nav-link">Leadership</a>
            <a href="/cabinet" class="nav-link active">Cabinet</a>
            <a href="/annualprogram" class="nav-link">Annual Programs</a>
            <a href="/annualgathering" class="nav-link">Annual Gathering</a>
            <a href="/past-presidents" class="nav-link">Past Presidents</a>
            <a href="/objectives" class="nav-link">Objectives</a>
        </div>
        <button class="admin-nav-btn" @onclick="OpenModal">
            <i class="bi bi-shield-lock-fill"></i> Admin
        </button>
    </div>
</div>

<div class="app">
    <div class="hero">
        <div class="hero-content">
            <span class="hero-tag">✦ C A B I N E T  M E M B E R S ✦</span>
            <h1 class="hero-title">cabinet <span class="highlight">members</span></h1>
            <div class="hero-line"></div>
            <p class="hero-desc">meet our dedicated cabinet team</p>
        </div>
    </div>

    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-number">@(cabinetMembers?.Count ?? 0)</div>
            <div class="stat-label">Total Members</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(cabinetMembers?.Count(x => x.Status == "Active") ?? 0)</div>
            <div class="stat-label">Currently Serving</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(cabinetMembers?.Count(x => x.Status != "Active") ?? 0)</div>
            <div class="stat-label">Alumni/Other</div>
        </div>
    </div>

    <div class="search-container">
        <div class="search-bar">
            <i class="fas fa-search"></i>
            <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="search by name or position..." />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="search-clear" @onclick="() => searchTerm = string.Empty">
                    <i class="fas fa-times"></i>
                </button>
            }
        </div>
        <div class="search-count">@FilteredMembers.Count() members found</div>
    </div>

    <div class="cards-container">
        @if (isLoading)
        {
            <div class="loading-state">
                <i class="fas fa-spinner fa-spin"></i>
                <p>loading cabinet members...</p>
            </div>
        }
        else if (cabinetMembers == null || !cabinetMembers.Any())
        {
            <div class="empty">
                <i class="fas fa-users-slash"></i>
                <p>no cabinet members yet</p>
                <button class="empty-btn" @onclick="OpenModal">add first member</button>
            </div>
        }
        else if (!FilteredMembers.Any())
        {
            <div class="empty">
                <i class="fas fa-search"></i>
                <p>no matching members found</p>
                <button class="empty-btn" @onclick="() => searchTerm = string.Empty">clear search</button>
            </div>
        }
        else
        {
            <div class="cards-grid">
                @foreach (var member in FilteredMembers)
                {
                    <div class="card" @onclick="() => QuickView(member)">
                        <div class="card-image">
                            <img src="@(string.IsNullOrEmpty(member.ImagePath) ? "https://via.placeholder.com/300x300?text=Member" : member.ImagePath)"
                                 alt="@member.Name"
                                 onerror="this.src='https://via.placeholder.com/300x300?text=No+Image'" />
                        </div>
                        <div class="card-info">
                            <h3>@member.Name</h3>
                            <span class="status-badge">@member.Status</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showQuickView && selectedMember != null)
{
    <div class="quickview" @onclick="CloseQuickView">
        <div class="quickview-card" @onclick:stopPropagation="true">
            <button class="quickview-close" @onclick="CloseQuickView">×</button>
            <div class="quickview-img">
                <img src="@selectedMember.ImagePath" alt="@selectedMember.Name" />
            </div>
            <div class="quickview-info text-center">
                <h2>@selectedMember.Name</h2>
                <div class="position-tag">@selectedMember.Status</div>
                <button class="close-btn" @onclick="CloseQuickView">Close</button>
            </div>
        </div>
    </div>
}

@if (showModal)
{
    <div class="admin-modal" @onclick="CloseModal">
        <div class="admin-card" @onclick:stopPropagation="true">
            <button class="admin-close" @onclick="CloseModal">×</button>

            @if (!isAdmin)
            {
                <div class="admin-header text-center">
                    <i class="fas fa-lock"></i>
                    <h2>Admin Access</h2>
                </div>
                <div class="admin-body">
                    <div class="input-icon">
                        <i class="fas fa-user"></i>
                        <input type="text" @bind="username" placeholder="Username" />
                    </div>
                    <div class="input-icon">
                        <i class="fas fa-lock"></i>
                        <input type="password" @bind="password" placeholder="Password" @onkeypress="EnterLogin" />
                    </div>
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="error-msg">@error</div>
                    }
                    <button class="login-btn" @onclick="Login">Login</button>
                </div>
            }
            else
            {
                <div class="admin-header text-center">
                    <i class="fas fa-sliders-h"></i>
                    <h2>Cabinet Management</h2>
                </div>
                <div class="admin-body">
                    @if (!string.IsNullOrEmpty(editError))
                    {
                        <div class="error-msg">@editError</div>
                    }

                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" @bind="editMember.Name" placeholder="e.g., Dr. Sarah Ahmed" />
                    </div>
                    <div class="form-group">
                        <label>Position / Role *</label>
                        <input type="text" @bind="editMember.Status" placeholder="e.g., General Secretary, Treasurer, Member" />
                    </div>
                    <div class="form-group">
                        <label>Profile Picture</label>
                        <div class="upload-box">
                            <InputFile OnChange="UploadImage" />
                            <div class="upload-content text-center">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span>Click to upload photo</span>
                            </div>
                        </div>
                        <small class="text-muted">✓ Image will show full face without cropping</small>
                    </div>
                    @if (!string.IsNullOrEmpty(editMember.ImagePath))
                    {
                        <div class="image-preview text-center">
                            <img src="@editMember.ImagePath" alt="Preview" />
                            <button class="delete-image" @onclick="DeleteImage" type="button">Remove</button>
                        </div>
                    }

                    <button class="save-btn" @onclick="Save" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                        }
                        else
                        {
                            <i class="fas fa-save"></i>
                        }
                        @(string.IsNullOrEmpty(editMember.Id) ? "Add Member" : "Update Member")
                    </button>

                    @if (!string.IsNullOrEmpty(editMember.Id))
                    {
                        <button class="cancel-btn" @onclick="CancelEdit">Cancel Edit</button>
                    }

                    <hr />

                    <div class="manage-header">
                        <i class="fas fa-list"></i>
                        <span>Manage Members (@(cabinetMembers?.Count ?? 0))</span>
                    </div>
                    <div class="items-list">
                        @if (cabinetMembers == null || !cabinetMembers.Any())
                        {
                            <div class="no-items">No members yet</div>
                        }
                        else
                        {
                            @foreach (var member in cabinetMembers)
                            {
                                <div class="manage-item">
                                    <div class="item-info">
                                        <div class="admin-image-preview">
                                            <img src="@(string.IsNullOrEmpty(member.ImagePath) ? "https://via.placeholder.com/40" : member.ImagePath)"
                                                 alt="@member.Name" />
                                        </div>
                                        <div>
                                            <strong>@member.Name</strong>
                                            <small>@member.Status</small>
                                        </div>
                                    </div>
                                    <div class="item-actions">
                                        <button class="icon-edit" @onclick="() => LoadEdit(member)">Edit</button>
                                        <button class="icon-delete" @onclick="() => Delete(member)">Delete</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <button class="logout-btn" @onclick="Logout">Logout</button>
                </div>
            }
            <button class="close-modal-btn" @onclick="CloseModal">Close</button>
        </div>
    </div>
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #0a0e27 0%, #0f1235 100%);
        min-height: 100vh;
    }

    /* Navbar */
    .main-navbar {
        background: rgba(8, 12, 26, 0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(124, 58, 237, 0.3);
        position: sticky;
        top: 0;
        z-index: 99;
    }

    .navbar-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .navbar-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 20px;
        font-weight: 700;
        background: linear-gradient(135deg, #c084fc, #7c3aed);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

        .navbar-brand i {
            font-size: 24px;
            color: #7c3aed;
        }

    .mobile-menu-btn {
        display: none;
        background: none;
        border: none;
        color: #c084fc;
        font-size: 24px;
        cursor: pointer;
    }

    .navbar-links {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
    }

    .nav-link {
        text-decoration: none;
        color: #94a3b8;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s;
        padding: 8px 0;
    }

        .nav-link:hover {
            color: #c084fc;
        }

        .nav-link.active {
            color: #c084fc;
            font-weight: 600;
            border-bottom: 2px solid #7c3aed;
        }

    .admin-nav-btn {
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

        .admin-nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
        }

    /* Hero */
    .hero {
        padding: 60px 20px 40px;
        text-align: center;
    }

    .hero-tag {
        font-size: 11px;
        letter-spacing: 4px;
        color: #c084fc;
        display: inline-block;
        margin-bottom: 20px;
    }

    .hero-title {
        font-size: 56px;
        font-weight: 700;
        color: #e2e8f0;
        margin-bottom: 20px;
    }

        .hero-title .highlight {
            background: linear-gradient(135deg, #c084fc, #7c3aed);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .hero-line {
        width: 70px;
        height: 3px;
        background: linear-gradient(90deg, #7c3aed, #c084fc);
        margin: 0 auto 20px;
        border-radius: 3px;
    }

    .hero-desc {
        font-size: 14px;
        color: #94a3b8;
    }

    /* Stats */
    .stats-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .stat-card {
        background: rgba(15, 18, 53, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 20px 40px;
        text-align: center;
        border: 1px solid rgba(124, 58, 237, 0.2);
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #c084fc, #7c3aed);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .stat-label {
        color: #94a3b8;
        font-size: 0.8rem;
        margin-top: 5px;
    }

    /* Search */
    .search-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px 20px;
    }

    .search-bar {
        position: relative;
        max-width: 400px;
        margin: 0 auto;
    }

        .search-bar i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #7c3aed;
            font-size: 14px;
        }

        .search-bar input {
            width: 100%;
            padding: 12px 35px 12px 42px;
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 40px;
            background: rgba(15, 18, 53, 0.8);
            color: #e2e8f0;
            font-size: 13px;
        }

            .search-bar input:focus {
                outline: none;
                border-color: #7c3aed;
                box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
            }

            .search-bar input::placeholder {
                color: #64748b;
            }

    .search-clear {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
    }

        .search-clear:hover {
            color: #c084fc;
        }

    .search-count {
        text-align: center;
        font-size: 12px;
        color: #94a3b8;
        margin-top: 10px;
    }

    /* Cards Container */
    .cards-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px 20px 60px;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 25px;
    }

    .loading-state {
        text-align: center;
        padding: 80px 20px;
        color: #c084fc;
    }

        .loading-state i {
            font-size: 48px;
            margin-bottom: 16px;
        }

    /* Card Styles */
    .card {
        background: rgba(15, 18, 53, 0.85);
        backdrop-filter: blur(12px);
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.3s ease;
        border: 1px solid rgba(124, 58, 237, 0.3);
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .card:hover {
            transform: translateY(-8px);
            border-color: #7c3aed;
            box-shadow: 0 20px 35px rgba(124, 58, 237, 0.25);
            background: rgba(15, 18, 53, 0.95);
        }

    .card-image {
        width: 100%;
        height: 260px;
        background: rgba(15, 18, 53, 0.85);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 15px;
            transition: transform 0.3s ease;
            background: transparent;
        }

    .card:hover .card-image img {
        transform: scale(1.05);
    }

    .card-info {
        padding: 18px;
        text-align: center;
        background: transparent;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .card-info h3 {
            font-size: 16px;
            font-weight: 700;
            color: #e2e8f0;
            margin-bottom: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .status-badge {
        display: inline-block;
        font-size: 11px;
        padding: 5px 14px;
        border-radius: 30px;
        font-weight: 500;
        background: rgba(124, 58, 237, 0.25);
        color: #c084fc;
        border: 1px solid rgba(124, 58, 237, 0.5);
    }

    /* Empty State */
    .empty {
        text-align: center;
        padding: 80px 20px;
        background: rgba(15, 18, 53, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        color: #94a3b8;
        border: 1px solid rgba(124, 58, 237, 0.2);
    }

        .empty i {
            font-size: 48px;
            margin-bottom: 16px;
            color: #7c3aed;
        }

        .empty p {
            font-size: 14px;
            margin-bottom: 20px;
        }

    .empty-btn {
        background: none;
        border: 1px solid #7c3aed;
        padding: 10px 28px;
        border-radius: 40px;
        font-size: 13px;
        color: #c084fc;
        cursor: pointer;
        transition: all 0.2s;
    }

        .empty-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #c084fc);
            color: white;
            border-color: transparent;
            transform: translateY(-2px);
        }

    /* Quick View */
    .quickview {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 200;
    }

    .quickview-card {
        background: linear-gradient(135deg, #0f1235, #0a0e27);
        border-radius: 28px;
        max-width: 450px;
        width: 90%;
        padding: 30px;
        text-align: center;
        border: 1px solid rgba(124, 58, 237, 0.4);
        position: relative;
    }

    .quickview-close {
        position: absolute;
        top: 15px;
        right: 20px;
        background: rgba(124, 58, 237, 0.3);
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        color: white;
        font-size: 18px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .quickview-close:hover {
            background: #7c3aed;
        }

    .quickview-img img {
        width: 150px;
        height: 150px;
        object-fit: contain;
        border-radius: 50%;
        margin: 20px auto;
        border: 3px solid #7c3aed;
        padding: 5px;
        background: #f8f9fa;
    }

    .quickview-info h2 {
        color: #e2e8f0;
        margin-bottom: 10px;
        font-size: 24px;
    }

    .position-tag {
        display: inline-block;
        padding: 6px 20px;
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        color: white;
        border-radius: 30px;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .close-btn {
        background: none;
        border: 1px solid #7c3aed;
        padding: 10px 30px;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 20px;
        color: #c084fc;
    }

        .close-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #c084fc);
            color: white;
            border-color: transparent;
        }

    /* Admin Modal */
    .admin-modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 150;
    }

    .admin-card {
        background: linear-gradient(135deg, #0f1235, #0a0e27);
        border-radius: 28px;
        width: 500px;
        max-height: 85vh;
        overflow-y: auto;
        border: 1px solid rgba(124, 58, 237, 0.4);
        padding: 20px;
    }

    .admin-close {
        float: right;
        background: none;
        border: none;
        font-size: 24px;
        color: #94a3b8;
        cursor: pointer;
    }

        .admin-close:hover {
            color: #c084fc;
        }

    .admin-header {
        text-align: center;
        margin-bottom: 20px;
        padding-top: 10px;
    }

        .admin-header i {
            font-size: 45px;
            color: #7c3aed;
            margin-bottom: 10px;
        }

        .admin-header h2 {
            color: #e2e8f0;
            font-size: 22px;
        }

    .admin-body {
        clear: both;
    }

    .input-icon {
        position: relative;
        margin-bottom: 15px;
    }

        .input-icon i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #7c3aed;
        }

        .input-icon input {
            width: 100%;
            padding: 12px 12px 12px 40px;
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 14px;
            background: rgba(15, 18, 53, 0.8);
            color: #e2e8f0;
            font-size: 14px;
        }

            .input-icon input:focus {
                outline: none;
                border-color: #7c3aed;
            }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 14px;
            background: rgba(15, 18, 53, 0.8);
            color: #e2e8f0;
            font-family: 'Poppins', sans-serif;
        }

            .form-group input:focus {
                outline: none;
                border-color: #7c3aed;
            }

    .upload-content {
        border: 2px dashed rgba(124, 58, 237, 0.5);
        border-radius: 14px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }

        .upload-content:hover {
            border-color: #7c3aed;
            background: rgba(124, 58, 237, 0.1);
        }

        .upload-content i {
            font-size: 28px;
            color: #c084fc;
