@code {
    private CabinetDAL dal = new CabinetDAL();
    private List<Cabinet> cabinetMembers = new();
    private Cabinet editMember = new Cabinet();
    private Cabinet? selectedMember = null;
    private bool showModal = false;
    private bool isAdmin = false;
    private bool showQuickView = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool mobileMenuOpen = false;
    private string username = "";
    private string password = "";
    private string error = "";
    private string editError = "";
    private string searchTerm = "";

    private IEnumerable<Cabinet> FilteredMembers => cabinetMembers?.Where(x =>
        string.IsNullOrEmpty(searchTerm) ||
        x.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        (x.Status != null && x.Status.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) ?? new List<Cabinet>();

    private string uploadPath => Path.Combine(env.WebRootPath, "uploads");

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            Directory.CreateDirectory(uploadPath);
            await LoadData();
        }
        catch (Exception ex)
        {
            error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        await Task.Run(() => { cabinetMembers = dal.GetAll(); });
        StateHasChanged();
    }

    private void OpenModal() => showModal = true;
    private void CloseModal() => showModal = false;

    private async Task EnterLogin(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Login();
    }

    private async Task Login()
    {
        await Task.Delay(1);
        if (username == "admin" && password == "admin123")
        {
            isAdmin = true;
            error = "";
        }
        else
        {
            error = "Invalid credentials. Use admin/admin123";
        }
        StateHasChanged();
    }

    private void Logout()
    {
        isAdmin = false;
        editMember = new Cabinet();
        editError = "";
        CloseModal();
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            var fileName = Guid.NewGuid() + Path.GetExtension(file.Name);
            var fullPath = Path.Combine(uploadPath, fileName);
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var fs = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fs);
            editMember.ImagePath = "/uploads/" + fileName;
            editError = "";
            StateHasChanged();
        }
        catch (Exception ex) { editError = $"Upload failed: {ex.Message}"; }
    }

    private void DeleteImage() { editMember.ImagePath = ""; }

    private async Task Save()
    {
        if (!isAdmin) return;

        if (string.IsNullOrWhiteSpace(editMember.Name))
        {
            editError = "Name is required";
            return;
        }

        if (string.IsNullOrWhiteSpace(editMember.Status))
        {
            editError = "Position/Role is required";
            return;
        }

        isSaving = true;
        editError = "";

        try
        {
            await Task.Run(() =>
            {
                if (string.IsNullOrEmpty(editMember.Id))
                {
                    // ✅ MongoDB will auto-generate ObjectId
                    dal.Add(editMember);
                }
                else
                {
                    dal.Update(editMember);
                }
            });

            await LoadData();
            editMember = new Cabinet(); // reset form
        }
        catch (Exception ex)
        {
            editError = $"Save failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void LoadEdit(Cabinet member)
    {
        editMember = new Cabinet { Id = member.Id, Name = member.Name, Status = member.Status, ImagePath = member.ImagePath };
        editError = "";
    }

    private void CancelEdit() { editMember = new Cabinet(); editError = ""; }

    private async Task Delete(Cabinet member)
    {
        if (!isAdmin) return;
        var confirmed = await jsRuntime.InvokeAsync<bool>("confirm", $"Delete {member.Name}?");
        if (confirmed)
        {
            await Task.Run(() => dal.Delete(member.Id));
            await LoadData();
            if (editMember.Id == member.Id) CancelEdit();
        }
    }

    private void QuickView(Cabinet member) { selectedMember = member; showQuickView = true; }
    private void CloseQuickView() { showQuickView = false; selectedMember = null; }
}